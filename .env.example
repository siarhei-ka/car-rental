# Copy to .env and set real values. .env is ignored by git.
# Optional: this computer's address on the local network, such as 192.168.0.41, to open the system
# from a phone. Without it, the system is reached at localhost only.
# PUBLIC_HOST=192.168.0.41
# Optional: HTTPS through a local proxy, see "HTTPS" in README.md.
# COMPOSE_PROFILES=https
# KEYCLOAK_PUBLIC_URL=https://192.168.0.41:8543
# CUSTOMER_UI_URL=https://192.168.0.41:8443
# ADMIN_UI_URL=https://192.168.0.41:9443
POSTGRES_PASSWORD=change-me
INVENTORY_DB_PASSWORD=change-me
RESERVATION_DB_PASSWORD=change-me
ADMINISTRATION_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
CUSTOMER_DB_PASSWORD=change-me
PRICING_DB_PASSWORD=change-me
ANCILLARY_DB_PASSWORD=change-me
INSURANCE_DB_PASSWORD=change-me
DISCOUNT_DB_PASSWORD=change-me
# The administrator of the Keycloak admin console (user "admin"), http://localhost:8180
KEYCLOAK_ADMIN_PASSWORD=change-me
# Secrets of the Keycloak clients of the two gateways. Any long random value
ADMIN_GATEWAY_CLIENT_SECRET=change-me
CUSTOMER_GATEWAY_CLIENT_SECRET=change-me
# Password of the test users of the realm (super-admin, admin-pl, admin-de, customer)
KEYCLOAK_TEST_USER_PASSWORD=change-me
# Secrets of the Keycloak clients of the services that call other services. Any long random value
INVENTORY_SERVICE_CLIENT_SECRET=change-me
RESERVATION_SERVICE_CLIENT_SECRET=change-me
SEARCH_SERVICE_CLIENT_SECRET=change-me
CACHE_UPDATER_CLIENT_SECRET=change-me
PRICING_SERVICE_CLIENT_SECRET=change-me
ANCILLARY_SERVICE_CLIENT_SECRET=change-me
INSURANCE_SERVICE_CLIENT_SECRET=change-me
DISCOUNT_SERVICE_CLIENT_SECRET=change-me
# The API key of the insurance provider, here its mock. Any long random value
INSURANCE_PROVIDER_API_KEY=change-me

# Optional: the OAuth client of a Google application for customer sign-in through Google, see
# infra/keycloak/README.md. Without it, customers sign in as the test user "customer".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
