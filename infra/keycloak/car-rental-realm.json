        "http://localhost:8088/login/oauth2/code/keycloak"
      ],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "${ADMIN_UI_URL:http://localhost:8090}/##http://localhost:8090/##http://localhost:5174/##http://localhost:8088/",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "country",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "country",
            "claim.name": "country",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
