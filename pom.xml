<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.10</version>
    <relativePath/>
  </parent>

  <groupId>psn.car.rental</groupId>
  <artifactId>car-rental</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Car Rental</name>
  <description>Car rental reservation system</description>

  <modules>
    <module>services/shared</module>
    <module>services/inventory-service</module>
    <module>services/reservation-service</module>
    <module>services/administration-service</module>
    <module>services/search-service</module>
    <module>services/cache-updater</module>
    <module>services/info-services/location</module>
    <module>services/info-services/car-type</module>
    <module>services/customer-service</module>
    <module>services/pricing-service</module>
    <module>services/ancillary-service</module>
    <module>services/discount-service</module>
    <module>services/insurance-provider-mock</module>
    <module>services/insurance-service</module>
    <module>services/api-gateway</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jacoco.version>0.8.16</jacoco.version>
    <spotless.version>3.11.0</spotless.version>
    <google-java-format.version>2.0.0</google-java-format.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
              </googleJavaFormat>
              <removeUnusedImports/>
            </java>
          </configuration>
          <executions>
            <execution>
              <id>check-format</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
