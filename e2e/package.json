{
  "name": "car-rental-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop",
    "test:phone": "playwright test --project=phone",
    "test:all-browsers": "E2E_ALL_BROWSERS=1 playwright test",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
